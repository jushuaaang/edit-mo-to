# edit-mo-to workflow repo: track ONLY the workflow, never client footage or projects.
# Everything is ignored by default; the workflow paths are re-included below.
/*
!/.gitignore
!/README.md
!/CLAUDE.md
!/docs/
!/.claude/

# inside .claude: no local session state or settings
/.claude/*
!/.claude/agents/
!/.claude/skills/
!/.claude/edit-mo-to/

# per-machine paths (see .claude/edit-mo-to/machine.example.json)
/.claude/edit-mo-to/machine.json

# installable dependencies: reinstalled by setup, never committed
node_modules/
.venv/
__pycache__/
.pytest_cache/
*.pyc

# media and renders never belong in this repo
*.mp4
*.mov
*.MOV
*.m4v
*.webm
*.wav
*.m4a
*.zip
*.tar
# (the 19 Pixabay SFX mp3s in motion/sfx are part of the workflow and stay tracked)

# client-private notes stay on this computer only (the repo is public): briefs, links, talent, offers
/.claude/edit-mo-to/clients/
# hand-edit log names clients and videos
/.claude/edit-mo-to/edit-patterns.jsonl

# each editor's own learned rules and hand-edit log (never uploaded)
.claude/edit-mo-to/my-preferences.md
.claude/edit-mo-to/edit-patterns.jsonl

# /practice-muna outputs (the editor's own footage)
_practice/
